<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotes Admin | Home</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Quotes Admin</a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/newAuthor">Add Author</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/authorList">View Authors</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/newQuote">Add Quote</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/quoteList">View Quotes</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">

    <div class="welcome-section text-center mb-5">
        <h1>Welcome to Quotes Admin</h1>
        <p class="lead">
            Manage your favorite quotes and their authors in one place.
        </p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h3>Add an Author</h3>
                    <p class="text-muted">
                        Add a new author and their personal information.
                    </p>
                    <a href="/newAuthor" class="btn btn-primary">
                        Create Author
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h3>Add a Quote</h3>
                    <p class="text-muted">
                        Create a quote and connect it to an author and category.
                    </p>
                    <a href="/newQuote" class="btn btn-primary">
                        Create Quote
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h3>Manage Authors</h3>
                    <p class="text-muted">
                        View existing authors and update their information.
                    </p>
                    <a href="/authorList" class="btn btn-outline-primary">
                        View Authors
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h3>Manage Quotes</h3>
                    <p class="text-muted">
                        View existing quotes and make changes.
                    </p>
                    <a href="/quoteList" class="btn btn-outline-primary">
                        View Quotes
                    </a>
                </div>
            </div>
        </div>

    </div>

</main>

<footer class="text-center py-4 text-muted">
    <p>Quotes Admin &copy; 2026</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>