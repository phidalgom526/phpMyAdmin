<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotes</title>
</head>
<body>
    <h1>Quotes</h1>
    <% for (let quote of quotes) { %>
        <div>
            <a href="/editQuote?quoteId=<%= quote.quoteId %>">Update</a>
            <%= quote.quote %>
            <% if (quote.firstName || quote.lastName) { %>
                — <%= quote.firstName || '' %> <%= quote.lastName || '' %>
            <% } %>
        </div>
    <% } %>
    <p><a href="/">Home</a></p>
</body>
</html>
