<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Author</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Quotes Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/newAuthor">Add Author</a></li>
                <li class="nav-item"><a class="nav-link active" href="/authorList">View Authors</a></li>
                <li class="nav-item"><a class="nav-link" href="/newQuote">Add Quote</a></li>
                <li class="nav-item"><a class="nav-link" href="/quoteList">View Quotes</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">
    <div class="form-container mx-auto">
        <h1 class="mb-2">Edit Author</h1>
        <p class="text-muted mb-4">Update the author's information.</p>

        <form action="/updateAuthor" method="POST">
            <input type="hidden" name="authorId" value="<%= formObject.authorId %>">

            <div class="mb-3">
                <label for="firstName" class="form-label">First Name</label>
                <input type="text" class="form-control" id="firstName" name="firstName"
                       value="<%= formObject.firstName || '' %>">
                <% if (formErrors?.firstName) { %>
                    <div class="text-danger"><%= formErrors.firstName %></div>
                <% } %>
            </div>

            <div class="mb-3">
                <label for="lastName" class="form-label">Last Name</label>
                <input type="text" class="form-control" id="lastName" name="lastName"
                       value="<%= formObject.lastName || '' %>">
                <% if (formErrors?.lastName) { %>
                    <div class="text-danger"><%= formErrors.lastName %></div>
                <% } %>
            </div>

            <div class="mb-3">
                <label for="dob" class="form-label">Date of Birth</label>
                <input type="date" class="form-control" id="dob" name="dob"
                       value="<%= formObject.dob || '' %>">
                <% if (formErrors?.dob) { %>
                    <div class="text-danger"><%= formErrors.dob %></div>
                <% } %>
            </div>

            <div class="mb-4">
                <label for="dod" class="form-label">Date of Death (Optional)</label>
                <input type="date" class="form-control" id="dod" name="dod"
                       value="<%= formObject.dod || '' %>">
                <% if (formErrors?.dod) { %>
                    <div class="text-danger"><%= formErrors.dod %></div>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/authorList" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>