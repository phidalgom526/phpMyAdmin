<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Quote</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Quotes Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/newAuthor">Add Author</a></li>
                <li class="nav-item"><a class="nav-link" href="/authorList">View Authors</a></li>
                <li class="nav-item"><a class="nav-link active" href="/newQuote">Add Quote</a></li>
                <li class="nav-item"><a class="nav-link" href="/quoteList">View Quotes</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">
    <div class="form-container mx-auto">
        <h1 class="mb-2">Add a New Quote</h1>
        <p class="text-muted mb-4">Enter the quote information below.</p>

        <form action="/insertQuote" method="POST">
            <div class="mb-3">
                <label for="quote" class="form-label">Quote</label>
                <textarea class="form-control" id="quote" name="quote" rows="4"><%= formObject?.quote || '' %></textarea>
                <% if (formErrors?.quote) { %>
                    <div class="text-danger"><%= formErrors.quote %></div>
                <% } %>
            </div>

            <div class="mb-3">
                <label for="authorId" class="form-label">Author</label>
                <select class="form-select" id="authorId" name="authorId">
                    <option value="">Select an author</option>
                    <% (authors || []).forEach(author => { %>
                        <option value="<%= author.authorId %>"
                                <%= String(formObject?.authorId || '') === String(author.authorId) ? 'selected' : '' %>>
                            <%= author.firstName %> <%= author.lastName %>
                        </option>
                    <% }) %>
                </select>
                <% if (formErrors?.authorId) { %>
                    <div class="text-danger"><%= formErrors.authorId %></div>
                <% } %>
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select class="form-select" id="category" name="category">
                    <option value="">Select a category</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.categoryName || category.category || category %>"
                                <%= String(formObject?.category || '') === String(category.categoryName || category.category || category) ? 'selected' : '' %>>
                            <%= category.categoryName || category.category || category %>
                        </option>
                    <% }) %>
                </select>
                <% if (formErrors?.category) { %>
                    <div class="text-danger"><%= formErrors.category %></div>
                <% } %>
            </div>

            <div class="mb-4">
                <label for="likes" class="form-label">Likes</label>
                <input type="number" class="form-control" id="likes" name="likes" min="0"
                       value="<%= formObject?.likes ?? 0 %>">
                <% if (formErrors?.likes) { %>
                    <div class="text-danger"><%= formErrors.likes %></div>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary">Create Quote</button>
            <a href="/" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>