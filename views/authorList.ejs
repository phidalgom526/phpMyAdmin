<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authors</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Quotes Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/newAuthor">Add Author</a></li>
                <li class="nav-item"><a class="nav-link active" href="/authorList">View Authors</a></li>
                <li class="nav-item"><a class="nav-link" href="/newQuote">Add Quote</a></li>
                <li class="nav-item"><a class="nav-link" href="/quoteList">View Quotes</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Authors</h1>
            <p class="text-muted">Manage the authors in your database.</p>
        </div>
        <a href="/newAuthor" class="btn btn-primary">+ Add Author</a>
    </div>

    <% if (authors.length === 0) { %>
        <div class="alert alert-info">No authors have been added yet.</div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Date of Birth</th>
                    <th>Date of Death</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                <% authors.forEach(author => { %>
                    <tr>
                        <td><%= author.firstName %></td>
                        <td><%= author.lastName %></td>
                        <td><%= author.dob ? String(author.dob).substring(0, 10) : '' %></td>
                        <td><%= author.dod ? String(author.dod).substring(0, 10) : '—' %></td>
                        <td>
                            <a href="/editAuthor?id=<%= author.authorId %>" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>